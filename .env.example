# Supabase 프로젝트 설정 → API 에서 복사
# 로컬 개발(supabase start)이면 `npx supabase status` 출력값 사용
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 라이엇 계정 연결 (PRD F3-11). 프로덕션 기본값은 꺼짐 — 로컬 .env.local 에서만 true
NEXT_PUBLIC_RIOT_LINK_ENABLED=false
# mock(기본) | real — real 은 Production 키 승인 후
NEXT_PUBLIC_RIOT_PROVIDER=mock

# 서버 전용 — 절대 NEXT_PUBLIC_ 붙이지 말 것 (클라이언트 번들에 노출됨)
RIOT_API_KEY=
RIOT_RSO_CLIENT_ID=
RIOT_RSO_CLIENT_SECRET=
RIOT_RSO_REDIRECT_URI=
