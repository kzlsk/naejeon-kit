# Supabase 프로젝트 설정 → API 에서 복사
# 로컬 개발(supabase start)이면 `npx supabase status` 출력값 사용
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 디스코드 자동 전송 (PRD F10). false 면 관련 UI·API 전부 숨김. 빌드 때 값이 박힘
NEXT_PUBLIC_DISCORD_ENABLED=false
# 서버 전용 — 절대 NEXT_PUBLIC_ 붙이지 말 것. Discord Developer Portal → OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# 예: https://<도메인>/api/discord/callback (Developer Portal 의 Redirects 에도 같은 값 등록)
DISCORD_REDIRECT_URI=
